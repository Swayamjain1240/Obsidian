# Obsidian backend environment
# Copy this file to backend/.env. Do not commit backend/.env.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/obsidian
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Run status polling has its own budget so a long run is never cut off by 429s.
RATE_LIMIT_POLL_MAX_REQUESTS=2400

# AI services stay disabled until a provider is explicitly approved.
AI_PROVIDER=disabled
AI_PROVIDER_TIMEOUT_MS=10000
# AI_PROVIDER_API_KEY=replace-me
# AI_PROVIDER_BASE_URL=https://provider.example.com/v1

# GitHub OAuth App. Uncomment and fill these values to enable sign-in.
# GITHUB_CLIENT_ID=replace-me
# GITHUB_CLIENT_SECRET=replace-me
# GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user,repo
# AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional AES-256-GCM keyring for persisted GitHub access tokens. Each entry is
# key-id:base64url-32-byte-key, separated by commas. Keep keys in a secret
# manager in production and retain old keys while records are being rotated.
# AUTH_TOKEN_ENCRYPTION_KEYS=current:replace-with-32-byte-base64url-key
# AUTH_TOKEN_ENCRYPTION_CURRENT_KEY_ID=current

# Privacy retention and cleanup. Durations are milliseconds and require
# organization approval before production use.
PRIVACY_SNAPSHOT_RETENTION_MS=604800000
PRIVACY_WORKSPACE_RETENTION_MS=86400000
PRIVACY_RUN_RETENTION_MS=2592000000
PRIVACY_PREVIEW_RETENTION_MS=86400000
PRIVACY_AI_CONTEXT_RETENTION_MS=86400000
PRIVACY_AUDIT_RETENTION_MS=31536000000
PRIVACY_CLEANUP_BATCH_SIZE=100
PRIVACY_DELETION_ACTIVE_POLICY=block

# Immutable repository snapshot limits
SNAPSHOT_MAX_BYTES=52428800
SNAPSHOT_ROOT=.obsidian-workspaces
SNAPSHOT_MAX_EXTRACTED_BYTES=209715200
SNAPSHOT_MAX_FILES=10000
SNAPSHOT_MAX_DIRECTORIES=5000
SNAPSHOT_MAX_SINGLE_FILE_BYTES=20971520
SNAPSHOT_MAX_PATH_LENGTH=1024
SNAPSHOT_EXTRACTION_TIMEOUT_MS=120000

# Evidence and completeness limits
DETECTION_MAX_EVIDENCE_FILE_BYTES=1048576
DETECTION_MAX_EVIDENCE_PATHS=100
DETECTION_MIN_VISIBLE_MS=5000
DETECTION_POLL_INTERVAL_MS=500
COMPLETENESS_MAX_FILE_BYTES=262144
COMPLETENESS_MAX_FILES=2000
COMPLETENESS_MAX_BYTES=8388608
COMPLETENESS_MAX_FINDINGS=500
COMPLETENESS_TIMEOUT_MS=30000

# Baseline execution limits
BASELINE_MAX_CHECKS=12
BASELINE_CHECK_TIMEOUT_MS=120000
BASELINE_MAX_TOTAL_TIMEOUT_MS=600000
BASELINE_MAX_OUTPUT_BYTES=65536
BASELINE_MAX_MEMORY_BYTES=536870912
BASELINE_MAX_PROCESSES=32
BASELINE_MAX_PATH_DEPTH=128
BASELINE_WORKER_IMAGE=obsidian-sandbox:dev
BASELINE_WORKER_SCRATCH_BYTES=134217728
BASELINE_WORKER_CLEANUP_TIMEOUT_MS=10000
BASELINE_WORKER_LEASE_MS=120000
BASELINE_NETWORK_MODE=blocked
# Production fails closed unless a verified OS/container worker is provided.
# Production must use a reviewed image digest, for example:
# BASELINE_WORKER_IMAGE=registry.example.com/obsidian-sandbox@sha256:<64-hex-digest>
# Production must point the API at a separately permissioned broker, for example:
# BASELINE_WORKER_BROKER_URL=http://worker-broker:4081
# BASELINE_WORKER_BROKER_TOKEN=<32-or-more-random-bytes>
# Local development/tests may use false for the bounded runner only.
BASELINE_REQUIRE_ISOLATION=false
