# Backend configuration
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/obsidian
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI services are disabled until a provider is explicitly approved.
AI_PROVIDER=disabled
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_TIMEOUT_MS=10000

# GitHub OAuth App (Part 2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user,repo
AUTH_SESSION_SECRET=

# Immutable repository snapshot configuration
SNAPSHOT_MAX_BYTES=52428800
SNAPSHOT_ROOT=.obsidian-workspaces
SNAPSHOT_MAX_EXTRACTED_BYTES=209715200
SNAPSHOT_MAX_FILES=10000
SNAPSHOT_MAX_DIRECTORIES=5000
SNAPSHOT_MAX_SINGLE_FILE_BYTES=20971520
SNAPSHOT_MAX_PATH_LENGTH=1024
SNAPSHOT_EXTRACTION_TIMEOUT_MS=120000
DETECTION_MAX_EVIDENCE_FILE_BYTES=1048576
DETECTION_MAX_EVIDENCE_PATHS=100
DETECTION_MIN_VISIBLE_MS=5000
DETECTION_POLL_INTERVAL_MS=500
COMPLETENESS_MAX_FILE_BYTES=262144
COMPLETENESS_MAX_FILES=2000
COMPLETENESS_MAX_BYTES=8388608
COMPLETENESS_MAX_FINDINGS=500
COMPLETENESS_TIMEOUT_MS=30000
BASELINE_MAX_CHECKS=12
BASELINE_CHECK_TIMEOUT_MS=120000
BASELINE_MAX_TOTAL_TIMEOUT_MS=600000
BASELINE_MAX_OUTPUT_BYTES=65536
